# JVM-mode image, used by default in docker-compose (no GraalVM required to
# `docker compose up`). Build the native image (Dockerfile.native) to reproduce
# the sub-second-startup numbers called out for this service.
FROM eclipse-temurin:21-jre-alpine
WORKDIR /work/
COPY target/quarkus-app/lib/ /work/lib/
COPY target/quarkus-app/*.jar /work/
COPY target/quarkus-app/app/ /work/app/
COPY target/quarkus-app/quarkus/ /work/quarkus/

EXPOSE 8082
ENTRYPOINT ["java", "-jar", "/work/quarkus-run.jar"]
